{
    "manifest_version" : 3,
    "name" : "LogStream",
    "version" : "1.0.0",
    "icons" : {
        "512" : "icons/icon128.png"
    },
    "description" : "Chrome extension which allows to view salesforce/apex log hustle free with better UI and accessibility.",
    "permissions" : [
        "storage",
        "alarms",
        "cookies",
        "activeTab"
    ],
    "host_permissions" : [
        "https://*.salesforce.com/*",
        "https://*.cloudforce.com/*",
        "https://*.salesforce.mil/*",
        "https://*.cloudforce.mil/*",
        "https://*.sfcrmproducts.cn/*",
        "https://*.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.lightning.force.com/*",
        "https://*.visual.force.com/*"
    ],
    "background" : {
        "service_worker" : "background.js",
        "type" : "module"
    },
    "action" : {
        "default_title" : "Open LogStream",
        "default_icon" : {
            "512" : "icons/icon128.png"
        }
    }
}
